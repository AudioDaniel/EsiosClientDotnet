<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Packaging Properties -->
    <PackageId>EsiosClient</PackageId>
    <Version>1.0.0</Version>
    <Authors>AudioDaniel</Authors>
    <Description>A reusable .NET client library for consuming the ESIOS API (Red Eléctrica de España).</Description>
    <PackageProjectUrl>https://github.com/AudioDaniel/EsiosClientDotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AudioDaniel/EsiosClientDotnet.git</RepositoryUrl>
    <PackageTags>esios;ree;electricity;api;spain</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>

</Project>
